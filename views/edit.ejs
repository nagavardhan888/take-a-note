<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <div class="container">
    <h1>edit your Note</h1>

     <form action="/update/<%= note._id %>" method="post" method="post">
    <input type="text" name="title"  placeholder="enter the title" value="<%=note.title%>"><br><br>
    <textarea name="content" id="content" cols="30" rows="10" placeholder="write here........"><%= note.content %></textarea><br><br>
    <button type="submit">ADD Note</button>
    </form>
    </div>
</body>
</html>