<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Note | <%= note.title %></title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <div class="edit-wrapper">
        <div class="edit-card">
            <div class="edit-header">
                <h2>Edit Your Note</h2>
            </div>

            <form action="/listings/<%= note._id %>?_method=PUT" method="POST">
                <div class="input-group">
                    <label for="title">Title</label>
                    <input type="text" name="listing[title]" id="title" value="<%= note.title %>" placeholder="Enter title...">
                </div>

                <div class="input-group">
                    <label for="content">Content</label>
                    <textarea name="listing[content]" id="content" rows="8" placeholder="Write your thoughts here..."><%= note.content %></textarea>
                </div>

                <div class="edit-actions">
                    <button type="submit" class="save-btn">Save Changes</button>
                    <a href="/listings" class="cancel-btn">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</body>
</html>